# المزوّد: gemini (له طبقة مجانية) أو claude
AI_PROVIDER=gemini

# Gemini: المفتاح من aistudio.google.com/apikey
GEMINI_API_KEY=ضع_المفتاح_هنا
# اسم النموذج: انظر صفحة Rate limits في AI Studio واختر نموذج Flash المتاح لك مجاناً
GEMINI_MODEL=gemini-flash-lite-latest
# نموذج توليد الصور (المرحلة 4). غيّره إن لم يعمل، الأسماء المتاحة في http://localhost:8000/models
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Claude (اختياري، مدفوع): فعّله بـ AI_PROVIDER=claude وثبّت حزمة anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
